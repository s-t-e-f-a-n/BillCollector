          "version": "repo-lines-v1:sha256:44a3c87a758e021ff23fed558b734a69c3842db27946627325c6ddb600e0734e:"
        }
      ]
    },
    {
      "id": "claim_2fe833af79e54f409d6206d3a02107d3",
      "statement": "The .dockerignore excludes local credentials and runtime artifacts (**/.env and **/.env.* with !**/.env.example retained, logs, .venv, __pycache__, .pytest*, .bc.lock, chrome*, apps/browser, apps/db, **/Downloads, **/*.html except mock-portal templates) from the Docker build context, which matters because the Dockerfile installs Python dependencies and the Playwright browser before copying the application code, so any leaked artifact would be baked into cached image layers.",
      "evidence": [
