    {
      "id": "claim_5a80af68add4474daf6a8440c4ecdbbc",
      "statement": "TaskScheduler mirrors the Task table (the source of truth) into an APScheduler AsyncIOScheduler with a persistent SQLAlchemy jobstore in the same bc.db file: resync() rebuilds all jobs at startup and sync_task() handles single-task changes; one cron job per enabled task with cron (id task-<id>, target module-level _task_job awaiting start_run) with coalesce=True, max_instances=1, and no misfire grace window.",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/scheduler.py#L1-L117",
          "version": "repo-lines-v1:sha256:aa6be242758c94fa89d1cafc25d5490a3d4feea818d2b7d38b0341b899dc608c:"
        }
      ]
    },
    {
      "id": "claim_84d867188d0a407b98ea0a42cf5e0bef",
      "statement": "Orchestrator.start_run claims a task via the atomic claim_task_run row lock (UPDATE ... WHERE status NOT IN ('running','waiting')), acquires the global asyncio semaphore sized by the max_concurrency setting (default 1), spawns the runner as 'python -m billcollector run <task_id>' with start_new_session=True (so the runner leads a process group for display-stack teardown and survives a SIGKILLed daemon), and hands off monitoring to its own asyncio task; claim and slot are released back to idle on cancellation or spawn failure.",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/db.py#L177-L187",
          "version": "repo-lines-v1:sha256:ec6c94ed6e48927901e9b4b447ded91f7a61b3840dac20584ddf7e2d585baa4f:"
        },
        {
