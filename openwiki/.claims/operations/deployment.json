    {
      "id": "claim_80a7e7ce0ba0452ba8a4cf55d343ed48",
      "statement": "The repository has a single Dockerfile (legacy Selenium Dockerfile removed, Dockerfile_pw renamed to it) building billcollector:latest from ubuntu:24.04 that refuses to build on non-amd64 architectures (TARGETARCH guard), runs as a numeric non-root user via USER ${APP_UID}:${APP_GID} (build args defaulting to 1000:1000), declares VOLUME /apps/Downloads, validates dependencies with `python3 -m pip check` and then purges the python3-pip and python3-wheel installers from the final image, and defaults to CMD [\"/bin/bash\"].",
      "evidence": [
        {
          "resource": "repo://CHANGELOG.md#L32-L35",
