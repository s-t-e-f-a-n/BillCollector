    {
      "id": "claim_06f491d6af20475d91de0d5cb5e19e9c",
      "statement": "install_docker-image.sh resolves the NAS mount targets CONSUMER_DIR and DB_DIR in order: environment variables, then a .env file next to the script parsed as plain KEY=VALUE lines only (no shell code executed, restricted to the keys CONSUMER_DIR/DB_DIR/APP_UID/APP_GID/SKIP_MOUNT_SETUP, only filling unset variables); both must be absolute paths to existing directories and are validated before the build starts, so a misconfiguration fails immediately instead of at the first production run. The script takes no engine argument (the legacy positional value `playwright` is still accepted) and builds with context set to its own directory so it works from any working directory.",
      "evidence": [
        {
          "resource": "repo://install_docker-image.sh#L23-L48",
          "version": "repo-lines-v1:sha256:72a450bf29b9d6e25ca7620560c4d037d0ee0e30a25bb4cb18d1dad2f8dc38d0:"
        },
        {
