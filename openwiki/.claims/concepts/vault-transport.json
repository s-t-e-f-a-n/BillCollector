    {
      "id": "claim_e95e36472df342ddaaed2cc6aaa103d3",
      "statement": "The vault session ignores ambient proxy configuration (session.trust_env = False), refuses redirects (allow_redirects=False and any 3xx response raises a final VaultTransportError), and sends a Host header that defaults to the configured API host/port but can be overridden by BW_API_HOST for a bw serve in another container (bw serve accepts only Host: 127.0.0.1:<port> as its DNS-rebinding protection); the Host value must be ASCII without whitespace or control characters or the request is refused before connection.",
      "evidence": [
        {
          "resource": "repo://apps/vault_transport.py#L65-L70",
          "version": "repo-lines-v1:sha256:a295f0d5d64ebd39d34f0ac793f28719d79b0e83d364d8041653beb4c4661603:"
        },
        {
