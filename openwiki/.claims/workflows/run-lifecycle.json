    {
      "id": "claim_abdbfaaecd7b4f9e934f6db5e10de54d",
      "statement": "Batch mode isolates per-(service, user)-pair failures: a vault credential error or a false return from retrieve_from_service_with_playwright sets a failed flag and continues to the next pair, and the process exits 1 at the end if any pair failed and 0 otherwise.",
      "evidence": [
        {
          "resource": "repo://apps/BillCollector.py#L91-L142",
          "version": "repo-lines-v1:sha256:37189587c29b663d55761074fae9996f4e894c072375f5b75b4eb95f072ac5c9:"
        }
      ]
    },
    {
      "id": "claim_f66e61754c5847889721c0a094c426f6",
      "statement": "In batch mode, retrieve_from_service_with_playwright returns True only when the run completed without aborting and at least one file downloaded successfully; perform_actions records every step into the legacy schema (a Service registry table plus one PageStatus_<service>_RunN table in the same apps/db/bc.db) and a finally block calls finalize_service_run so every started service run holds a terminal success/failure even on abort.",
      "evidence": [
        {
          "resource": "repo://apps/BillCollectorServices_pw.py#L161-L194",
