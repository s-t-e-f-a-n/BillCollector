    {
      "id": "claim_a683a037a7a441098206fbf577a89149",
      "statement": "A BillCollector recipe is a per-portal YAML document - top-level object with optional $schema and a services array, each service requiring serviceName and steps, each step requiring an integer step - validated against the JSON Schema draft-07 document apps/recipes_playwright/recipe-pw-schema.yaml, which forbids additional top-level properties.",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/config.py#L34-L37",
          "version": "repo-lines-v1:sha256:865e747ea79ffdc676cb94632b03d8951d19f377ca8bab191fa9a3d62a208faa:"
        },
        {
