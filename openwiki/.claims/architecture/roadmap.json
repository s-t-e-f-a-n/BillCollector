        }
      ]
    },
    {
      "id": "claim_2444a96b0f2743bcac5c5e7cdfc02561",
      "statement": "The daemon scheduler mirrors the Task table into an APScheduler AsyncIOScheduler backed by a persistent SQLAlchemy jobstore in the same bc.db file: one cron job per enabled task that carries a cron expression, rebuilt from the Task table at startup (the jobstore is a cache and the Task table always wins), with one job added/updated per task change.",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/scheduler.py#L1-L22",
          "version": "repo-lines-v1:sha256:a7d687ea0fb39a4dc597375a85e0cf063a867e503f4ea9e0812662b843fa8bb8:"
