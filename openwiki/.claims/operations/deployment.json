    {
      "id": "claim_06f96a0c3af141019b8811853a144651",
      "statement": "BillCollector.sh guards against double starts with an exclusive non-blocking flock on apps/.bc.lock held for the whole docker run (released on exit, so overlapping cron/UI/manual starts are rejected) and refuses to start unless apps/.env exists and is readable; it then runs `docker run` mounting apps/.env read-only, apps/Downloads and apps/db as writable volumes, and invokes `python3 ./BillCollector.py <ini> [debug]` in billcollector:latest.",
      "evidence": [
