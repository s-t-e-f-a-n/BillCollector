    {
      "id": "claim_943e54c15e7b430a8850c62feebcb5d3",
      "statement": "This repository is a sanitized public mirror of a private upstream: day-to-day development happens on the upstream, validated milestones are promoted to its production branch, and a maintainer-only sync script (stored in the private copy, not in the public repository) refreshes the public main — it checks the published branch out detached in a throwaway git worktree, strips the internal directories .kilo, .vscode, .private, and openwiki from the staging area, amends the tip commit only if files were removed (reusing the existing message/author and pinning the committer date to the source commit so the amend is deterministic), force-pushes the sanitized state to the public main, and optionally force-pushes a matching release tag whose sanitized hash differs from the private tip by design; the public main thus reflects the published production state, and the repository must stay publishable as-is with no internal hostnames or personal setup details.",
      "evidence": [
        {
          "resource": "repo://.private/sync_github.sh#L1-L43",
