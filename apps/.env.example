# Definitions for BillCollector App
BW_API_URL=<local bw serve HTTP URL, e.g. http://127.0.0.1:8087>
# BW_API_HOST=127.0.0.1:8087
# BC_CHROMIUM_ARGS=--disable-software-rasterizer   # dev-host (WSL2) launch workaround only; unset on NAS/production
# BC_UI_HOST=127.0.0.1   # daemon UI bind host (default 127.0.0.1; set 0.0.0.0 inside the container)
