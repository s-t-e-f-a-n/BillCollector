    {
      "id": "claim_d68ac4d86f4d499ebcb3f149a4fd4c50",
      "statement": "A stuck daemon run (a non-graceful step failing after 3 attempts, a failed download, or an explicit wait_user step) pauses instead of aborting: the runner builds a machine-readable pause context, persists it on the Run row, flips the task to waiting, and serves the versioned control-socket protocol (v1: screenshot, elements, context, click, fill, press, drag, resume, cancel) from its main thread until resume, cancel, or the pause deadline; every pause also pushes an ntfy deep link to the session page, best-effort.",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/control.py#L1-L43",
          "version": "repo-lines-v1:sha256:e9afa878ff95e745b1cb9a40523ff5ab5a2acd0ac8d4fd5b2bdfac24c5e48053:"
