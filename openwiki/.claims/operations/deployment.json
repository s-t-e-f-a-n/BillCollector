    {
      "id": "claim_efd1280e4e7a41aa8b4ce385a24d3101",
      "statement": "install_local.sh (run as `bash install_local.sh playwright`) prepares a local development stack: it installs host prerequisites (jq, wget, curl, unzip, python3, python3-pip, python3-venv) via apt-get, creates the virtual environment apps/.venv and installs apps/requirements.txt into it, and installs Playwright chromium + ffmpeg into the repo-local apps/browser directory via PLAYWRIGHT_BROWSERS_PATH plus the Chrome system dependencies; it refuses to install into a browser directory that already contains chromium/ffmpeg subfolders, requires exactly the argument `playwright`, and is tested on Ubuntu 24.04 LTS and WSL2.",
      "evidence": [
        {
          "resource": "repo://install_local.sh#L14-L16",
          "version": "repo-lines-v1:sha256:9b49b9cdcdff3c1f8a6ecb60edc37731f38c1aaf52a6a2281f0fdbb1a4d67468:"
