    {
      "id": "claim_337112e3ee624622b80e9d86797eccd9",
      "statement": "The daemon control protocol (control.py) is versioned JSON-line messages (first field v, PROTOCOL_VERSION = 1) over one Unix socket per paused run, with request {v, action, args}, response {v, ok, ...}, actions screenshot/elements/context/click/fill/press/drag plus reserved resume and cancel, capped at MAX_MESSAGE_BYTES (4 MiB) with a 120 s client timeout.",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/control.py#L1-L44",
          "version": "repo-lines-v1:sha256:00b9165e1bbebdf9a466e9e111adc23d60d5ee327f977a7d22ce51f2986b3d0c:"
