# Used by deploy_remote.sh
#
# remote (ssh) user and host
REMOTE_USER=username
REMOTE_HOST=hostname or ip address
# remote path to cloned git repo of BillCollector
REMOTE_PATH=/path/to/cloned/billcollector/repo
# installation script for building the docker image
INSTALL_SCRIPT=install_docker-image.sh
# no arguments needed (kept for back-compat with older .env files passing `playwright`)
INSTALL_SCRIPT_ARGS=
# git branch to be fetched
GIT_BRANCH=main
# NAS bind-mount targets for install_docker-image.sh (paperless consumer
# folder + database folder inside it); forwarded to the remote install
# script. The same two keys are read from a .env file next to the script
# when it is run directly on the NAS.
CONSUMER_DIR=/path/to/your/paperless/inbox/_BillCollector_/
DB_DIR=/path/to/your/paperless/inbox/_BillCollector_/db
