# Definitions for BillCollector App
BW_API_URL=<local bw serve HTTP URL, e.g. http://127.0.0.1:8087>
# BW_API_HOST=127.0.0.1:8087
# BC_CHROMIUM_ARGS=--disable-software-rasterizer   # dev-host (WSL2) launch workaround only; unset on NAS/production
# BC_UI_HOST=127.0.0.1   # daemon UI bind host (default 127.0.0.1; set 0.0.0.0 inside the container)
# Optional user recipe overlay: a directory of per-service recipe files that
# shadow the built-in ones (a same-named file wins) and receive UI edits.
# With Docker Compose this is set in the compose file (/apps/recipes); for a
# direct `python -m billcollector` run point it at a mounted/created folder.
# BC_RECIPE_EXTRA_DIR=/path/to/recipes
# TZ=Europe/Zurich   # direct Python/docker run only; runtime environment wins
# With Docker Compose, set TZ in the root .env instead (default UTC).
