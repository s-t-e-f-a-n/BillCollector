          "version": "repo-lines-v1:sha256:996a5de050bbe8d2dcbf77d9cd1343c81a25ed9387cdde55eb296460bb68dee3:"
        }
      ]
    },
    {
      "id": "claim_dd8a03acc82a4d83926f38516378d664",
      "statement": "A 400 from the TOTP endpoint is an expected condition, not a failure: get_totp returns None (the item exists but has no TOTP entry) so the run continues without an OTP, while any other 4xx status is re-raised as VaultAPIError.",
