    {
      "id": "claim_5dfeab350a3c436e849607c049dd1b97",
      "statement": "Each daemon task run executes as an isolated `python -m billcollector run` subprocess: the daemon process never imports scraping code so a runner crash cannot take down the UI/scheduler; the orchestrator claims the task with a DB row lock, gates spawns with the max_concurrency semaphore, marks orphaned runs interrupted at startup, and exposes start_run (scheduler and Run now) and stop_run (UI Stop).",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/orchestrator.py#L1-L73",
          "version": "repo-lines-v1:sha256:de360e6860996730ea63495c07a200b914091976e25ac5d08e5402d5ebb94b8a:"
        }
      ]
    },
    {
      "id": "claim_63a8dd9a092548db8ba800390351daa5",
      "statement": "The runner executes one task as a sync Playwright step loop with the same vault preflight semantics as the batch entry point, a persistent per-task browser profile, a per-run Xvfb/x11vnc/websockify display stack, and graceful interruption on SIGTERM/SIGINT that reaps the display stack and ends the run with result=interrupted.",
      "evidence": [
        {
          "resource": "repo://apps/billcollector/runner.py#L1-L33",
