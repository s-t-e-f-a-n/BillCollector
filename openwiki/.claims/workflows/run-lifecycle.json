  "claims": [
    {
      "id": "claim_b66fdaeddac141a3ae5d97c27b788b55",
      "statement": "BillCollector.sh guards cron double-starts with an exclusive, non-blocking flock on fd 9 of apps/.bc.lock held for the whole docker run; a lost flock prints an 'already running' message and the script exits 1, and the kernel releases the lock when the script exits.",
      "evidence": [
        {
          "resource": "repo://BillCollector.sh#L9-L22",
          "version": "repo-lines-v1:sha256:0f519ebe7ab72b7180a13d80e1639ee0eddc8ee80236f20231c0470163ea7ad5:"
        }
      ]
    },
    {
      "id": "claim_954357943e2242ee9aa4cefd73abcfda",
      "statement": "BillCollector.py calls acquire_run_lock() from apps/helpers/BillCollectorHelpers.py right before the service loop: a non-blocking LOCK_EX flock on the same apps/.bc.lock file that sys.exit(1)s on BlockingIOError; the returned file handle is kept alive for the process lifetime because closing the fd releases the lock, so no stale-lock cleanup is needed.",
      "evidence": [
        {
          "resource": "repo://apps/BillCollector.py#L193-L198",
          "version": "repo-lines-v1:sha256:5450740841a720128c345aac8f55ba0ec626789aa013852797bea2c7a4d8b0ed:"
        },
        {
          "resource": "repo://apps/helpers/BillCollectorHelpers.py#L38-L62",
          "version": "repo-lines-v1:sha256:b707b12da3b311337ba4b297ac8d0455c7dd6576813ae54d8bec7ecd616365c7:"
        }
      ]
    },
    {
      "id": "claim_ca4004b5f3284ce0accd785ba3f7a39a",
      "statement": "The batch preflight in WebRetriDoc is process-fatal: pinned_api_url must vet BW_API_URL as local, bitwarden_api_check_status must report 'unlocked', and POST /sync must succeed; any failure exits 1 before any service runs.",
