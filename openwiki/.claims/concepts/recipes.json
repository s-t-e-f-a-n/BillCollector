    {
      "id": "claim_09f1451eb95f4aeda3b8bc293fb0abf1",
      "statement": "A step is a chain of method entries dispatched in order via getattr on the current Playwright object (starting at the Page), with each method's non-None result becoming the next receiver, so locator methods (locator, get_by_role, get_by_label, get_by_text, get_by_title, get_by_placeholder, get_by_test_id), chain-continuing methods (first, content_frame), and element actions (click, fill, press) interleave; when all processed arguments are dicts they are merged into keyword arguments, otherwise passed positionally.",
      "evidence": [
        {
          "resource": "repo://apps/BillCollectorServices_pw.py#L380-L421",
          "version": "repo-lines-v1:sha256:2f2ce24566f49c969613d189d7c08c7d4e049dc474957cc28c279dcec86e4bb1:"
        },
        {
